<section class="about">
  {% render 'flos-image',
    image: section.settings.drip,
    asset: 'flos-maple-drip.webp',
    alt: '',
    class: 'about-drip',
    width: 838,
    intrinsic_width: 838,
    height: 638
  %}
  <div class="wrap about-inner">
    {%- if section.settings.eyebrow != blank -%}
      <p class="eyebrow purple-text">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}
    <h2>
      {{ section.settings.heading | escape }}
      {%- if section.settings.heading_emphasis != blank -%}
        <br>
        <em>{{ section.settings.heading_emphasis | escape }}</em>
      {%- endif -%}
    </h2>
    <div class="about-copy">
      {%- if section.settings.paragraph_1 != blank -%}
        <p>{{ section.settings.paragraph_1 | escape }}</p>
      {%- endif -%}
      {%- if section.settings.paragraph_2 != blank -%}
        <p>{{ section.settings.paragraph_2 | escape }}</p>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "About story",
  "tag": "div",
  "class": "flos flos-about",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "About"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "A love letter"
    },
    {
      "type": "text",
      "id": "heading_emphasis",
      "label": "Heading emphasis",
      "default": "you can eat."
    },
    {
      "type": "textarea",
      "id": "paragraph_1",
      "label": "First paragraph",
      "default": "Born out of cherished Saturday morning traditions. We also saw pancakes as a beautiful blank canvas. After researching and incorporating healthy food sources into our diets, like calming herb teas and chia-seed enriched smoothies we thought, why not incorporate it into our breakfast plate too?"
    },
    {
      "type": "textarea",
      "id": "paragraph_2",
      "label": "Second paragraph",
      "default": "Flo's Best original pancake mix is like a love letter in edible form, bringing delight to your table, taking time off your hands, and introducing new flavors to your palate."
    },
    {
      "type": "image_picker",
      "id": "drip",
      "label": "Maple drip"
    }
  ],
  "presets": [
    {
      "name": "About story"
    }
  ]
}
{% endschema %}
