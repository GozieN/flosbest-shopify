<section class="flavors wrap" id="flavors">
  <div class="section-heading">
    <div class="section-heading-copy">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow purple-text">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h2>
        {{ section.settings.heading | escape }}
        {%- if section.settings.heading_emphasis != blank -%}
          <br>
          <em>{{ section.settings.heading_emphasis | escape }}</em>
        {%- endif -%}
      </h2>
      {%- if section.settings.note != blank -%}
        <p class="section-note">{{ section.settings.note | escape }}</p>
      {%- endif -%}
    </div>
  </div>
  <div class="flavor-grid">
    {%- for block in section.blocks -%}
      {%- liquid
        assign flavor_asset = block.settings.asset
        if flavor_asset == blank
          assign flavor_asset = 'flos-buttermilk.jpg'
        endif
      -%}
      {%- if block.settings.product != blank -%}
        <a class="flavor-card" href="{{ block.settings.product.url }}" style="background-color: {{ block.settings.color }};" {{ block.shopify_attributes }}>
      {%- else -%}
        <article class="flavor-card" style="background-color: {{ block.settings.color }};" {{ block.shopify_attributes }}>
      {%- endif -%}
        {% render 'flos-image',
          image: block.settings.image,
          asset: flavor_asset,
          alt: block.settings.title,
          class: 'flavor-image',
          width: 800,
          intrinsic_width: 765,
          height: 1024
        %}
        <div>
          <strong>{{ block.settings.title | escape }}</strong>
          <small>{{ block.settings.subtitle | escape }}</small>
        </div>
      {%- if block.settings.product != blank -%}
        </a>
      {%- else -%}
        </article>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Flavors",
  "tag": "div",
  "class": "flos flos-flavors",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The breakfast lineup"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Pick your"
    },
    {
      "type": "text",
      "id": "heading_emphasis",
      "label": "Heading emphasis",
      "default": "pancake mood."
    },
    {
      "type": "textarea",
      "id": "note",
      "label": "Note",
      "default": "Every flavor is enriched with fermented milk, and moringa and boosted with superfood flavors."
    }
  ],
  "blocks": [
    {
      "type": "flavor",
      "name": "Flavor",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Name",
          "default": "Flavor"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle",
          "default": "Warm + cozy"
        },
        {
          "type": "color",
          "id": "color",
          "label": "Card color",
          "default": "#f6c2ca"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Photo"
        },
        {
          "type": "text",
          "id": "asset",
          "label": "Packaged photo",
          "info": "Theme file used until a photo is uploaded. Example: flos-cinnamon.webp",
          "default": "flos-buttermilk.jpg"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Flavors",
      "blocks": [
        {
          "type": "flavor",
          "settings": {
            "title": "Cinnamon Chia Sensation",
            "subtitle": "Warm + cozy",
            "color": "#f6c2ca",
            "asset": "flos-cinnamon.webp"
          }
        },
        {
          "type": "flavor",
          "settings": {
            "title": "Buttermilk Bites",
            "subtitle": "Classic + fluffy",
            "color": "#fff18b",
            "asset": "flos-buttermilk.jpg"
          }
        },
        {
          "type": "flavor",
          "settings": {
            "title": "Matcha Mornings",
            "subtitle": "Earthy + fresh",
            "color": "#c8e397",
            "asset": "flos-matcha.webp"
          }
        },
        {
          "type": "flavor",
          "settings": {
            "title": "Blueberry Acai Bliss",
            "subtitle": "Fruity + Sweet",
            "color": "#cbb8f8",
            "asset": "flos-blueberry.webp"
          }
        }
      ]
    }
  ]
}
{% endschema %}
