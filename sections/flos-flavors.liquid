<section class="flavors wrap" id="flavors">
  <div class="section-heading">
    <div class="section-heading-copy">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow purple-text">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h2>
        {{ section.settings.heading | escape }}
        {%- if section.settings.heading_emphasis != blank -%}
          <br>
          <em>{{ section.settings.heading_emphasis | escape }}</em>
        {%- endif -%}
      </h2>
      {%- if section.settings.note != blank -%}
        <p class="section-note">{{ section.settings.note | escape }}</p>
      {%- endif -%}
    </div>
  </div>
  <div class="flavor-grid">
    {%- for block in section.blocks -%}
      <div {{ block.shopify_attributes }}>
        {% render 'flos-flavor-card',
          product: block.settings.product,
          title: block.settings.title,
          subtitle: block.settings.subtitle,
          color: block.settings.color,
          image: block.settings.image,
          asset: block.settings.asset
        %}
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Flavors",
  "tag": "div",
  "class": "flos flos-flavors",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The breakfast lineup"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Pick your"
    },
    {
      "type": "text",
      "id": "heading_emphasis",
      "label": "Heading emphasis",
      "default": "pancake mood."
    },
    {
      "type": "textarea",
      "id": "note",
      "label": "Note",
      "default": "Every flavor is enriched with fermented milk, and moringa and boosted with superfood flavors."
    }
  ],
  "blocks": [
    {
      "type": "flavor",
      "name": "Flavor",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product",
          "info": "The catalog and product page use this product. Leave blank and the card still links if the name matches the product handle."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Name",
          "default": "Flavor"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle",
          "default": "Warm + cozy"
        },
        {
          "type": "color",
          "id": "color",
          "label": "Card color",
          "info": "Homepage card color. The catalog uses the same color when the product handle is one of the four flavors, or when the product has a Card color metafield (custom.card_color).",
          "default": "#f6c2ca"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Photo"
        },
        {
          "type": "text",
          "id": "asset",
          "label": "Packaged photo",
          "info": "Theme file used until a photo is uploaded. Example: flos-cinnamon.webp",
          "default": "flos-buttermilk.jpg"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Flavors",
      "blocks": [
        {
          "type": "flavor",
          "settings": {
            "title": "Cinnamon Chia Sensation",
            "subtitle": "Warm + cozy",
            "color": "#f6c2ca",
            "asset": "flos-cinnamon.webp"
          }
        },
        {
          "type": "flavor",
          "settings": {
            "title": "Buttermilk Bites",
            "subtitle": "Classic + fluffy",
            "color": "#fff18b",
            "asset": "flos-buttermilk.jpg"
          }
        },
        {
          "type": "flavor",
          "settings": {
            "title": "Matcha Mornings",
            "subtitle": "Earthy + fresh",
            "color": "#c8e397",
            "asset": "flos-matcha.webp"
          }
        },
        {
          "type": "flavor",
          "settings": {
            "title": "Blueberry Acai Bliss",
            "subtitle": "Fruity + Sweet",
            "color": "#cbb8f8",
            "asset": "flos-blueberry.webp"
          }
        }
      ]
    }
  ]
}
{% endschema %}
