{%- liquid
  assign shop_url = routes.all_products_collection_url
  if section.settings.button_link != blank
    assign shop_url = section.settings.button_link
  elsif section.settings.product != blank
    assign shop_url = section.settings.product.url
  endif
-%}
<section class="shop wrap" id="shop">
  <div class="shop-card">
    <div>
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow purple-text">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h2>
        {{ section.settings.heading | escape }}
        {%- if section.settings.heading_emphasis != blank -%}
          <br>
          <em>{{ section.settings.heading_emphasis | escape }}</em>
        {%- endif -%}
      </h2>
      {%- if section.settings.text != blank -%}
        <p>{{ section.settings.text | escape }}</p>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a class="pill-button" href="{{ shop_url }}">
          {{ section.settings.button_label | escape }}
          <span aria-hidden="true">↗</span>
        </a>
      {%- endif -%}
    </div>
    <div class="box-art" aria-hidden="true">
      <div class="package">
        {{ section.settings.package_kicker | escape }}<br>
        <strong>{{ section.settings.package_emphasis | escape }}</strong><br>
        {{ section.settings.package_line | escape }}<br>
        {{ section.settings.package_footer | escape }}
      </div>
      <div class="stack-art"><i></i><i></i><i></i><i></i></div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Shop card",
  "tag": "div",
  "class": "flos flos-shop",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Get the Goods"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Make your best"
    },
    {
      "type": "text",
      "id": "heading_emphasis",
      "label": "Heading emphasis",
      "default": "breakkie."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Warm spice, fresh, classic or fruity a chia crunch, and the trusted moringa, superfood base in every box."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop the launch"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Product",
      "info": "Used when the button link is empty."
    },
    {
      "type": "text",
      "id": "package_kicker",
      "label": "Package line 1",
      "default": "FLO'S"
    },
    {
      "type": "text",
      "id": "package_emphasis",
      "label": "Package emphasis",
      "default": "cinnamon chia"
    },
    {
      "type": "text",
      "id": "package_line",
      "label": "Package line 3",
      "default": "sensation"
    },
    {
      "type": "text",
      "id": "package_footer",
      "label": "Package line 4",
      "default": "pancakes"
    }
  ],
  "presets": [
    {
      "name": "Shop card"
    }
  ]
}
{% endschema %}
