{% comment %}
  Small brand icons for perks, steps, moringa, and values.
  They inherit currentColor so each section can tint them.

  @param name {string} grains, lightning, leaf, egg, package, pot, fork, heart, sun, drop, clock
  @param size {number} pixel size, default 32
{% endcomment %}
{%- assign icon_size = size | default: 32 -%}
{%- case name -%}
  {%- when 'grains' -%}
    <svg viewBox="0 0 32 32" width="{{ icon_size }}" height="{{ icon_size }}" fill="none" aria-hidden="true"><path d="M16 28V11" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path d="M16 12c0-4 3-7 8-8-1 5-4 8-8 8Z" fill="currentColor" opacity=".35"/><path d="M16 12c0-4-3-7-8-8 1 5 4 8 8 8Z" fill="currentColor"/><path d="M16 18c0-3 2.2-5 6-6-1 3.6-3 5.6-6 6Z" fill="currentColor" opacity=".35"/><path d="M16 18c0-3-2.2-5-6-6 1 3.6 3 5.6 6 6Z" fill="currentColor"/></svg>
  {%- when 'lightning' -%}
    <svg viewBox="0 0 32 32" width="{{ icon_size }}" height="{{ icon_size }}" aria-hidden="true"><path fill="currentColor" d="M18 2 6 18h8l-1.5 12L26 13h-8.5L18 2Z"/><path fill="currentColor" opacity=".35" d="M14.5 18H6l12 12-1.2-8.2"/></svg>
  {%- when 'leaf' -%}
    <svg viewBox="0 0 32 32" width="{{ icon_size }}" height="{{ icon_size }}" fill="none" aria-hidden="true"><path d="M7 25C18 25 26 17 26 6 15 6 7 14 7 25Z" fill="currentColor" opacity=".35"/><path d="M7 25C18 25 26 17 26 6 15 6 7 14 7 25Z" stroke="currentColor" stroke-width="2"/><path d="M8 24c5-5 10-9 18-10" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
  {%- when 'egg' -%}
    <svg viewBox="0 0 32 32" width="{{ icon_size }}" height="{{ icon_size }}" aria-hidden="true"><path fill="currentColor" opacity=".35" d="M16 3c6 0 10 7 10 13a10 10 0 0 1-20 0C6 10 10 3 16 3Z"/><path fill="currentColor" d="M16 5c4.6 0 8 5.6 8 11a8 8 0 0 1-16 0C8 10.6 11.4 5 16 5Z"/><circle cx="16" cy="17" r="3" fill="#fffdf5"/></svg>
  {%- when 'package' -%}
    <svg viewBox="0 0 32 32" width="{{ icon_size }}" height="{{ icon_size }}" fill="none" aria-hidden="true"><path d="M6 11 16 6l10 5v10l-10 5-10-5V11Z" fill="currentColor" opacity=".28"/><path d="M6 11 16 6l10 5v10l-10 5-10-5V11Z" stroke="currentColor" stroke-width="2"/><path d="M6 11l10 5 10-5M16 16v10" stroke="currentColor" stroke-width="2"/></svg>
  {%- when 'pot' -%}
    <svg viewBox="0 0 32 32" width="{{ icon_size }}" height="{{ icon_size }}" fill="none" aria-hidden="true"><path d="M8 14h16v7a6 6 0 0 1-6 6h-4a6 6 0 0 1-6-6v-7Z" fill="currentColor" opacity=".28"/><path d="M8 14h16v7a6 6 0 0 1-6 6h-4a6 6 0 0 1-6-6v-7Z" stroke="currentColor" stroke-width="2"/><path d="M5 14h22M12 8c.4 2 1.6 3 4 3s3.6-1 4-3" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
  {%- when 'fork' -%}
    <svg viewBox="0 0 32 32" width="{{ icon_size }}" height="{{ icon_size }}" fill="none" aria-hidden="true"><path d="M12 4v8a3 3 0 0 0 3 3v12M22 4v23M9 4v7M15 4v7" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path d="M9 4v7M15 4v7M12 12a3 3 0 0 0 3 3" stroke="currentColor" stroke-width="2" opacity=".4" stroke-linecap="round"/></svg>
  {%- when 'heart' -%}
    <svg viewBox="0 0 32 32" width="{{ icon_size }}" height="{{ icon_size }}" aria-hidden="true"><path fill="currentColor" opacity=".35" d="M16 27S5 19.5 5 12.2A5.7 5.7 0 0 1 16 10a5.7 5.7 0 0 1 11 2.2C27 19.5 16 27 16 27Z"/><path fill="currentColor" d="M16 25s-9-6.4-9-12.2A4.6 4.6 0 0 1 16 11a4.6 4.6 0 0 1 9 1.8C25 18.6 16 25 16 25Z"/></svg>
  {%- when 'sun' -%}
    <svg viewBox="0 0 32 32" width="{{ icon_size }}" height="{{ icon_size }}" fill="none" aria-hidden="true"><circle cx="16" cy="16" r="5" fill="currentColor"/><g stroke="currentColor" stroke-width="2" stroke-linecap="round" opacity=".7"><path d="M16 4v3M16 25v3M4 16h3M25 16h3M7.5 7.5l2.1 2.1M22.4 22.4l2.1 2.1M7.5 24.5l2.1-2.1M22.4 9.6l2.1-2.1"/></g></svg>
  {%- when 'drop' -%}
    <svg viewBox="0 0 32 32" width="{{ icon_size }}" height="{{ icon_size }}" aria-hidden="true"><path fill="currentColor" d="M16 3s8 9 8 15a8 8 0 0 1-16 0c0-6 8-15 8-15Z"/><path fill="#fff" opacity=".35" d="M13 18a3 3 0 0 0 3 3"/></svg>
  {%- when 'clock' -%}
    <svg viewBox="0 0 32 32" width="{{ icon_size }}" height="{{ icon_size }}" fill="none" aria-hidden="true"><circle cx="16" cy="16" r="10" fill="currentColor" opacity=".28"/><circle cx="16" cy="16" r="10" stroke="currentColor" stroke-width="2"/><path d="M16 10v6l4 3" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
{%- endcase -%}
